# 小米 MiMo Token Plan / OpenAI 兼容配置
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_CHAT_MODEL=mimo-v2.5-pro

# 聊天模型 Provider：Demo 入口固定使用 mimo
CHAT_PROVIDER=mimo

# Embedding Provider：dashscope 或 local
# local 适合只想用一个聊天模型 key 跑通 demo；正式 RAG 可改为 dashscope。
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_DIMENSION=1024

# 可选：阿里云百炼 DashScope API Key（仅在你主动改为 DashScope embedding/chat 时需要）
# 申请地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key

# 默认模型配置见 config/rag.yml：
# chat_model_name: qwen3-max
# embedding_model_name: text-embedding-v4

# KeyGuard V2 多 Agent 编排
KEYGUARD_AGENT_VERSION=v2
# 工单工作台独立操作员令牌；未配置时工作台默认关闭
KEYGUARD_OPERATOR_TOKEN=
LANGGRAPH_STRICT_MSGPACK=true
KEYGUARD_TICKET_DB=data/keyguard_v2.db
KEYGUARD_CHECKPOINT_DB=data/keyguard_v2_checkpoints.sqlite3
